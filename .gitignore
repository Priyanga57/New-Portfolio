# ── Dependencies ──────────────────────────────────────
node_modules/

# ── Build output ──────────────────────────────────────
dist/
dist-ssr/
build/

# ── Environment variables (never commit real secrets) ─
.env
.env.local
.env.*.local
# .env.example is intentionally NOT ignored (safe placeholder)

# ── Logs ──────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ── Vite / TypeScript cache ────────────────────────────
.vite/
*.tsbuildinfo
tsconfig.tsbuildinfo

# ── Testing ───────────────────────────────────────────
coverage/
.nyc_output/

# ── OS artefacts ──────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Editor directories ────────────────────────────────
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ── Misc ──────────────────────────────────────────────
*.local
.cache/
tmp/
